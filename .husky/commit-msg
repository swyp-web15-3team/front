commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# 병합/리버트 커밋은 검사 제외
if echo "$commit_msg" | grep -Eq "^(Merge|Revert) "; then
  exit 0
fi

pattern="^(✨ update|🎉 add|🐛 bugfix|♻️ refactor|🔧 fix|🚚 move|🔥 del|✅ test|💄 style|🙈 gitfix|📦 script): .+"

if ! echo "$commit_msg" | grep -Eq "$pattern"; then
  echo "❌ 커밋 메시지 형식이 올바르지 않습니다."
  echo ""
  echo "형식: <이모지 타입>: <작업내용>"
  echo ""
  echo "  ✨ update  : 해당 파일에 새로운 기능이 생김"
  echo "  🎉 add     : 없던 파일을 생성함, 초기 세팅"
  echo "  🐛 bugfix  : 버그 수정"
  echo "  ♻️ refactor: 코드 리팩토링"
  echo "  🔧 fix     : 코드 수정"
  echo "  🚚 move    : 파일 옮김/정리"
  echo "  🔥 del     : 기능/파일을 삭제"
  echo "  ✅ test    : 테스트 코드를 작성"
  echo "  💄 style   : css"
  echo "  🙈 gitfix  : gitignore 수정"
  echo "  📦 script  : package.json 변경(npm 설치 등)"
  echo ""
  echo "예: 🎉 add: 로그인 페이지 생성"
  exit 1
fi
