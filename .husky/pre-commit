pnpm exec lint-staged

current_branch=$(git rev-parse --abbrev-ref HEAD)
protected_branches="^(main|master|develop)$"
branch_pattern="^(feat|fix|chore)/.+"

if ! echo "$current_branch" | grep -Eq "$protected_branches"; then
  if ! echo "$current_branch" | grep -Eq "$branch_pattern"; then
    echo "❌ 브랜치명이 컨벤션을 따르지 않습니다: $current_branch"
    echo "   feat/기능명, fix/버그명, chore/작업명 형식을 사용해주세요."
    exit 1
  fi
fi
